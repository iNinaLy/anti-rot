# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Container paths; for local backend use sqlite:///./data/app.db and ./media
# PostgreSQL alternative: postgresql+psycopg://user:password@host/database
DATABASE_URL=sqlite:////data/app.db
MEDIA_DIR=/media
STATIC_DIR=/app/frontend/dist
ACCESS_TOKEN_MINUTES=15
# Persistent, rolling sign-in cookie; each successful refresh renews this period.
REFRESH_TOKEN_DAYS=180
# FSRS probability of recall at the next scheduled review (0.70–0.99)
FSRS_DESIRED_RETENTION=0.90
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_CARD=10
MAX_IMAGE_DIMENSION=1600
MAX_CSV_BYTES=5242880
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
# true behind HTTPS; false only for local HTTP development / trusted LAN HTTP
COOKIE_SECURE=false
PORT=8080
BIND_ADDRESS=127.0.0.1
# Optional prebuilt GHCR image, otherwise Compose builds daymark:local
APP_IMAGE=daymark:local
# Free Web Push reminders. Keys are generated once and kept in the database volume.
PUSH_KEYS_FILE=/data/push-keys.json
PUSH_CONTACT=mailto:admin@example.com
REMINDERS_ENABLED=true
# Public RSS only; no subscription or API key. Set false to disable external feed requests.
NEWS_FETCH_ENABLED=true
# Optional local AI: docker compose --profile ai up -d; see README for the model pull.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:0.6b
# Nightly snapshots include database, media and notification keys; Malaysia time.
BACKUPS_ENABLED=true
BACKUP_DIR=/backups
BACKUP_TIME=03:00
BACKUP_KEEP=7
# Only needed for compose.postgres.yml. Use a URL-safe random password.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
